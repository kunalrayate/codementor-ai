# NOTE: you can skip all AI_* variables and instead set the key in the app: Admin -> AI Settings.
# Copy to .env (docker compose) or export these variables before `mvn spring-boot:run`.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---------- AI provider: choose ONE block ----------
# 1) Google Gemini (free tier) - key from https://aistudio.google.com/apikey
AI_API_KEY=your-gemini-key
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_CHAT_PATH=/v1beta/openai/chat/completions
AI_EMBEDDINGS_PATH=/v1beta/openai/embeddings
AI_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001

# 2) OpenAI (paid) - https://platform.openai.com/api-keys
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com
# AI_MODEL=gpt-4o-mini

# 3) Groq (free tier) - https://console.groq.com/keys   (no embeddings -> PDF search uses keywords)
# AI_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai
# AI_MODEL=llama-3.3-70b-versatile

# 4) Ollama (free, runs on your PC) - install Ollama, then: ollama pull llama3.2 && ollama pull nomic-embed-text
# AI_API_KEY=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.2
# AI_EMBEDDING_MODEL=nomic-embed-text

# ---------- Code sandbox ----------
# auto (default) = Docker if running, else local | docker = strict | local = dev only, NOT isolated
# SANDBOX_MODE=auto
